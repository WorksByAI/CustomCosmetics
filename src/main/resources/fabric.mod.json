{
  "schemaVersion": 1,
  "id": "customcosmetics",
  "version": "${version}",
  "name": "CustomSkyBlock",
  "icon": "assets/customcosmetics/icon.png",
  "description": "A QOL mod for Hypixel SkyBlock.",
  "license": "AGPL-3.0-or-later",
  "authors": ["CustomSkyBlock contributors"],
  "contact": {
    "sources": "https://github.com/WorksByAI/CustomCosmetics",
    "issues": "https://github.com/WorksByAI/CustomCosmetics/issues",
    "email": "tory@toryhi.com"
  },
  "mixins": [
    "customcosmetics.mixins.json",
    "csb-bobby-261.mixins.json", "csb-bobby-262.mixins.json", "csb-bobby-263.mixins.json",
    "csb-motionblur-261.mixins.json", "csb-motionblur-262.mixins.json", "csb-motionblur-263.mixins.json"
  ],
  "environment": "client",
  "entrypoints": {
    "preLaunch": [
      "com.customcosmetics.features.gameplay.BobbyIntegration",
      "com.customcosmetics.features.gameplay.NaturalMotionBlurIntegration"
    ],
    "client": ["com.customcosmetics.client.CustomCosmeticsClient"],
    "modmenu": ["com.customcosmetics.compatibility.ModMenuEntry"],
    "sodium:config_api_user": ["com.customcosmetics.compatibility.BobbySodiumSettings"]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": ">=26.1 <26.4",
    "java": ">=25",
    "fabric-api": ">=0.145.1"
  },
  "suggests": {
    "hypixel-mod-api": ">=1.0"
  }
}
